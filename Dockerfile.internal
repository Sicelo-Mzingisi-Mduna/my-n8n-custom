# Use Python Debian base (has apt, Python, pip)
FROM python:3.11-slim

# Install Node.js and npm
RUN apt-get update && apt-get install -y curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install n8n and the Python task runner globally
RUN npm install -g n8n@2.2.5 @n8n/task-runner-python

# Create the 'node' user
RUN useradd -m -u 1000 node

# Create a directory for the runner's virtual environment
RUN mkdir -p /opt/runners/task-runner-python
RUN python3 -m venv /opt/runners/task-runner-python/.venv

# Install Python packages into that venv
RUN /opt/runners/task-runner-python/.venv/bin/pip install --no-cache-dir \
    requests \
    pandas \
    numpy \
    sqlalchemy \
    psycopg2-binary \
    pymongo \
    python-dotenv \
    openpyxl

# Set environment variables for both processes
ENV N8N_RUNNERS_ENABLED=true
ENV N8N_RUNNERS_MODE=external
ENV N8N_RUNNERS_AUTH_TOKEN=a9x4HbP1YzW8c3B3sNQdF0RZ6BeYJX7DkC
ENV N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
ENV N8N_RUNNERS_TASK_BROKER_URI=http://localhost:5679

# Create an entrypoint script that starts both n8n and the task runner
RUN echo '#!/bin/bash\nn8n-task-runner-python &\nn8n start' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

# Ensure ownership
RUN chown -R node:node /opt/runners /entrypoint.sh

USER node

EXPOSE 5678
CMD ["/entrypoint.sh"]