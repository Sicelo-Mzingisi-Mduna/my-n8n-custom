FROM n8nio/n8n:2.2.5

USER root

# Install required Python packages into the pre‑existing runner venv
RUN /opt/runners/task-runner-python/.venv/bin/pip install --no-cache-dir \
    requests \
    pandas \
    numpy \
    sqlalchemy \
    psycopg2-binary \
    pymongo \
    python-dotenv \
    openpyxl

# Ensure correct ownership
RUN chown -R node:node /opt/runners/task-runner-python

USER node